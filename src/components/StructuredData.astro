---
// Renders schema.org JSON-LD. Pass one schema object or an array of them;
// use with `slot="head"` so the script lands inside <head>.
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;
const serializedSchema = JSON.stringify(schema)
  .replaceAll('<', '\\u003c')
  .replaceAll('\u2028', '\\u2028')
  .replaceAll('\u2029', '\\u2029');
---

<script is:inline type="application/ld+json" set:html={serializedSchema} />

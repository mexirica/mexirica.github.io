---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import { withBase } from '../../lib/url';
import { formatDate, t } from '../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('works');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const site = Astro.site ?? new URL(Astro.url.origin);
const absolute = (path: string) => new URL(withBase(path), site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: entry.data.title,
  description: entry.data.description,
  codeRepository: entry.data.repo,
  programmingLanguage: entry.data.tech,
  url: absolute(`/works/${entry.id}/`),
  author: { '@type': 'Person', name: 'Rodrigo Mecheri' },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  image={withBase(`/og/works/${entry.id}.png`)}
>
  <StructuredData slot="head" schema={schema} />
  <article data-pagefind-body>
    <header class="page-head section article-head">
      <p class="eyebrow">{t('work.eyebrow')}</p>
      <a class="text-link return-link" href={withBase('/works/')}>← All works</a>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="entry-meta">
        <time datetime={entry.data.publishDate.toISOString()}
          >{formatDate(entry.data.publishDate)}</time
        >
        <span>{entry.data.tech.join(' / ')}</span>
      </div>
      {
        entry.data.repo && (
          <div class="action-row">
            <a class="text-link" href={entry.data.repo}>
              {t('work.repository')}
            </a>
          </div>
        )
      }
      {
        entry.data.thumbnail && (
          <Image
            class="article-image"
            src={entry.data.thumbnail}
            alt=""
            widths={[720, 1040, 1400]}
            sizes="(min-width: 900px) 72rem, 100vw"
          />
        )
      }
    </header>

    <div class="section article-layout">
      <aside class="article-toc">
        <p class="eyebrow">{t('work.stackEyebrow')}</p>
        <ul class="tech-list">
          {entry.data.tech.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

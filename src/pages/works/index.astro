---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { sortWorks, workPath, worksForLocale } from '../../lib/content';
import { SITE } from '../../consts';
import { t } from '../../i18n';

const works = sortWorks(worksForLocale(await getCollection('works'), 'en'));
---

<BaseLayout
  title={t('works.title')}
  description={`Selected projects and case studies — ${SITE.title}.`}
>
  <section class="page-head section">
    <p class="eyebrow">{t('works.eyebrow')}</p>
    <h1>Open-source systems and developer tools.</h1>
    <p class="lead">Open-source projects, tools, and experiments I’m working on</p>
  </section>

  <section class="section" aria-label={t('works.listLabel')}>
    <div class="work-list">
      {
        works.map((work) => (
          <article class="work-card">
            <p class="entry-meta">{work.data.tech.join(' / ')}</p>
            <h2>
              <a href={withBase(workPath(work))}>{work.data.title}</a>
            </h2>
            <p>{work.data.description}</p>
            {work.data.repo && (
              <div class="action-row">
                <a class="text-link" href={work.data.repo}>
                  {t('work.repository')}
                </a>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

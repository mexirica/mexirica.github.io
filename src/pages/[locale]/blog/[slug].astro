---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import Comments from '../../../components/Comments.astro';
import {
  postPath,
  postSlug,
  postsForLocale,
  postTranslationKey,
  sortPosts,
} from '../../../lib/content';
import { localizedPath, withBase } from '../../../lib/url';
import {
  formatDateFor,
  getTranslator,
  PREFIXED_LOCALES,
  readingTimeFor,
  type Locale,
} from '../../../i18n';
import { SITE } from '../../../consts';

interface PostProps {
  entry: CollectionEntry<'blog'>;
  newer: CollectionEntry<'blog'> | null;
  older: CollectionEntry<'blog'> | null;
  related: CollectionEntry<'blog'>[];
  locale: Locale;
  translations: Partial<Record<Locale, string>>;
}

export async function getStaticPaths() {
  const allEntries = await getCollection('blog', ({ data }) => !data.draft);
  return PREFIXED_LOCALES.flatMap((locale) => {
    const entries = sortPosts(postsForLocale(allEntries, locale));
    return entries.map((entry, index) => {
      const related = entries
        .filter((other) => other.id !== entry.id)
        .map((other) => ({
          post: other,
          shared: other.data.tags.filter((tag) => entry.data.tags.includes(tag)).length,
        }))
        .filter(({ shared }) => shared > 0)
        .sort(
          (a, b) =>
            b.shared - a.shared ||
            b.post.data.publishDate.valueOf() - a.post.data.publishDate.valueOf(),
        )
        .slice(0, 3)
        .map(({ post }) => post);
      const key = postTranslationKey(entry);
      const translations = Object.fromEntries(
        allEntries
          .filter((candidate) => postTranslationKey(candidate) === key)
          .map((candidate) => [candidate.data.locale, postPath(candidate)]),
      ) as Partial<Record<Locale, string>>;
      return {
        params: { locale, slug: postSlug(entry) },
        props: {
          entry,
          newer: entries[index - 1] ?? null,
          older: entries[index + 1] ?? null,
          related,
          locale,
          translations,
        } satisfies PostProps,
      };
    });
  });
}

const { entry, newer, older, related, locale, translations } = Astro.props as PostProps;
const t = getTranslator(locale);
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const site = Astro.site ?? new URL(Astro.url.origin);
const absolute = (path: string) => new URL(withBase(path), site).href;
const path = postPath(entry);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.publishDate.toISOString(),
    inLanguage: locale,
    url: absolute(path),
    ...(SITE.author ? { author: { '@type': 'Person', name: SITE.author } } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('post.breadcrumbHome'),
        item: absolute(localizedPath('/', locale)),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t('post.breadcrumbBlog'),
        item: absolute(localizedPath('/blog/', locale)),
      },
      { '@type': 'ListItem', position: 3, name: entry.data.title },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  translations={translations}
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
>
  <StructuredData slot="head" schema={schema} />
  <article data-pagefind-body>
    <header class="page-head section article-head">
      <p class="eyebrow">{t('post.eyebrow')}</p>
      <a class="text-link return-link" href={withBase(localizedPath('/blog/', locale))}
        >{t('post.return')}</a
      >
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="entry-meta">
        <time datetime={entry.data.publishDate.toISOString()}
          >{formatDateFor(entry.data.publishDate, locale)}</time
        >
        <span>{readingTimeFor(remarkPluginFrontmatter.minutesRead, locale)}</span>
        <span class="inline-tags">
          {
            entry.data.tags.map((tag) => (
              <a href={withBase(localizedPath(`/blog/tags/${tag}/`, locale))}>{tag}</a>
            ))
          }
        </span>
      </div>
      {
        entry.data.heroImage && (
          <Image
            class="article-image"
            src={entry.data.heroImage}
            alt=""
            widths={[720, 1040, 1400]}
            sizes="(min-width: 900px) 72rem, 100vw"
          />
        )
      }
    </header>
    <div class="section article-layout">
      <aside class="article-toc" aria-label={t('post.tocLabel')}>
        <p class="eyebrow">{t('post.contentsEyebrow')}</p>
        <nav>
          {
            headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
          }
        </nav>
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
  {
    (older || newer) && (
      <nav class="section post-nav-section" aria-label={t('post.adjacentLabel')}>
        <div class="post-nav">
          {older ? (
            <a rel="prev" href={withBase(postPath(older))}>
              <span class="post-nav-label">{t('post.previous')}</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
          {newer ? (
            <a rel="next" class="post-nav-next" href={withBase(postPath(newer))}>
              <span class="post-nav-label">{t('post.next')}</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          ) : (
            <span aria-hidden="true" />
          )}
        </div>
      </nav>
    )
  }
  {
    related.length > 0 && (
      <aside class="section post-nav-section" aria-labelledby="related-heading">
        <p class="eyebrow" id="related-heading">
          {t('post.relatedEyebrow')}
        </p>
        <ul class="related-list">
          {related.map((post) => (
            <li>
              <a href={withBase(postPath(post))}>{post.data.title}</a>
              <time datetime={post.data.publishDate.toISOString()}>
                {formatDateFor(post.data.publishDate, locale)}
              </time>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
  <Comments locale={locale} />
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sortWorks, workPath, worksForLocale } from '../../../lib/content';
import { withBase } from '../../../lib/url';
import { getTranslator, PREFIXED_LOCALES, type Locale } from '../../../i18n';
import { getPageStrings } from '../../../i18n/pages';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = getTranslator(locale);
const copy = getPageStrings(locale);
const works = sortWorks(worksForLocale(await getCollection('works'), locale));
---

<BaseLayout locale={locale} title={t('works.title')} description={copy.worksDescription}>
  <section class="page-head section">
    <p class="eyebrow">{t('works.eyebrow')}</p>
    <h1>{copy.worksHeading}</h1>
    <p class="lead">{copy.worksLead}</p>
  </section>
  <section class="section" aria-label={t('works.listLabel')}>
    <div class="work-list">
      {
        works.map((work) => (
          <article class="work-card">
            <p class="entry-meta">{work.data.tech.join(' / ')}</p>
            <h2>
              <a href={withBase(workPath(work))}>{work.data.title}</a>
            </h2>
            <p>{work.data.description}</p>
            {work.data.repo && (
              <div class="action-row">
                <a class="text-link" href={work.data.repo}>
                  {t('work.repository')}
                </a>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import { localizedPath, withBase } from '../../../lib/url';
import { workPath, workSlug, worksForLocale, workTranslationKey } from '../../../lib/content';
import { formatDateFor, getTranslator, PREFIXED_LOCALES, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  const allWorks = await getCollection('works');
  return PREFIXED_LOCALES.flatMap((locale) =>
    worksForLocale(allWorks, locale).map((entry) => {
      const key = workTranslationKey(entry);
      const translations = Object.fromEntries(
        allWorks
          .filter((candidate) => workTranslationKey(candidate) === key)
          .map((candidate) => [candidate.data.locale, workPath(candidate)]),
      ) as Partial<Record<Locale, string>>;
      return {
        params: { locale, slug: workSlug(entry) },
        props: { entry, locale, translations },
      };
    }),
  );
}

const { entry, locale, translations } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection<'works'>>>[number];
  locale: Locale;
  translations: Partial<Record<Locale, string>>;
};
const t = getTranslator(locale);
const { Content } = await render(entry);
const site = Astro.site ?? new URL(Astro.url.origin);
const pagePath = workPath(entry);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: entry.data.title,
  description: entry.data.description,
  codeRepository: entry.data.repo,
  programmingLanguage: entry.data.tech,
  inLanguage: locale,
  url: new URL(withBase(pagePath), site).href,
  author: { '@type': 'Person', name: 'Rodrigo Mecheri' },
};
---

<BaseLayout
  locale={locale}
  translations={translations}
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  image={withBase(`/og/works/${workSlug(entry)}.png`)}
>
  <StructuredData slot="head" schema={schema} />
  <article data-pagefind-body>
    <header class="page-head section article-head">
      <p class="eyebrow">{t('work.eyebrow')}</p>
      <a class="text-link return-link" href={withBase(localizedPath('/works/', locale))}
        >{t('work.return')}</a
      >
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="entry-meta">
        <time datetime={entry.data.publishDate.toISOString()}
          >{formatDateFor(entry.data.publishDate, locale)}</time
        >
        <span>{entry.data.tech.join(' / ')}</span>
      </div>
      {
        entry.data.repo && (
          <div class="action-row">
            <a class="text-link" href={entry.data.repo}>
              {t('work.repository')}
            </a>
          </div>
        )
      }
      {
        entry.data.thumbnail && (
          <Image
            class="article-image"
            src={entry.data.thumbnail}
            alt=""
            widths={[720, 1040, 1400]}
            sizes="(min-width: 900px) 72rem, 100vw"
          />
        )
      }
    </header>
    <div class="section article-layout">
      <aside class="article-toc">
        <p class="eyebrow">{t('work.stackEyebrow')}</p>
        <ul class="tech-list">{entry.data.tech.map((item) => <li>{item}</li>)}</ul>
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
</BaseLayout>

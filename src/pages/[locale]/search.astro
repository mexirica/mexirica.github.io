---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { getTranslator, PREFIXED_LOCALES, type Locale } from '../../i18n';
import { getPageStrings } from '../../i18n/pages';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = getTranslator(locale);
const copy = getPageStrings(locale);
const bundlePath = withBase('/pagefind/');
---

<BaseLayout locale={locale} title={t('search.title')} description={copy.searchDescription}>
  <link slot="head" rel="stylesheet" href={`${bundlePath}pagefind-ui.css`} />
  <meta slot="head" name="robots" content="noindex, follow" />
  <section class="page-head section">
    <p class="eyebrow">{t('search.eyebrow')}</p>
    <h1>{copy.searchHeading}</h1>
  </section>
  <section class="section search-section" aria-label={t('search.sectionLabel')}>
    <div id="search" data-bundle-path={bundlePath}>
      <p class="search-fallback" set:html={t('search.fallback')} />
    </div>
    <script is:inline data-astro-rerun>
      (() => {
        const container = document.getElementById('search');
        if (!container) return;
        const bundlePath = container.dataset.bundlePath;
        const initSearch = () => {
          container.querySelector('.search-fallback')?.remove();
          new PagefindUI({
            element: '#search',
            bundlePath,
            showImages: false,
            showSubResults: true,
            autofocus: false,
          });
        };
        if (window.PagefindUI) initSearch();
        else {
          const script = document.createElement('script');
          script.src = `${bundlePath}pagefind-ui.js`;
          script.onload = initSearch;
          document.head.append(script);
        }
      })();
    </script>
  </section>
</BaseLayout>

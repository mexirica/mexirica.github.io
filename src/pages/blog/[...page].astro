---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import PostEntry from '../../components/PostEntry.astro';
import { withBase } from '../../lib/url';
import { collectTags, sortPosts } from '../../lib/content';
import { SITE } from '../../consts';
import { readingTime, t } from '../../i18n';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
  const allTags = collectTags(posts);
  return paginate(posts, { pageSize: 10, props: { allTags } });
}) satisfies GetStaticPaths;

const { page, allTags } = Astro.props;
const posts = page.data;

const readingTimes = new Map(
  await Promise.all(
    posts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return [post.id, readingTime(remarkPluginFrontmatter.minutesRead)] as const;
    }),
  ),
);

const pageTitle =
  page.currentPage === 1 ? t('blog.title') : t('blog.titlePaged', { page: page.currentPage });
---

<BaseLayout
  title={pageTitle}
  description={`Technical notes on Go, systems, and developer tooling by ${SITE.title}.`}
>
  <section class="page-head section">
    <p class="eyebrow">{t('blog.eyebrow')}</p>
    <h1>Notes from building systems.</h1>
    <p class="lead">
      Implementation notes on Go, storage infrastructure, and the decisions behind the projects on
      this site.
    </p>
  </section>

  <section class="section content-index" aria-label={t('blog.listLabel')}>
    <div class="index-sidebar">
      <p class="eyebrow">{t('blog.tagsEyebrow')}</p>
      <nav class="tag-cloud" aria-label={t('blog.tagsNavLabel')}>
        {allTags.map((tag) => <a href={withBase(`/blog/tags/${tag}/`)}>{tag}</a>)}
      </nav>
    </div>

    <div>
      <div class="entry-list">
        {
          posts.map((post) => (
            <PostEntry post={post} readingTime={readingTimes.get(post.id) ?? ''} />
          ))
        }
      </div>
      <Pagination page={page} />
    </div>
  </section>
</BaseLayout>
